				<column name="book_uuid" />
			</index>
			<fk name="fk_book_author_book" to_schema="Schema_" to_table="book" type="NonIdentifying" mandatory="y" cardinality="ZeroMore" range_from="0" range_to="0" delete_action="cascade" >
