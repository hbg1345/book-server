			<column name="user_id" type="VARCHAR" mandatory="y" />
			<column name="created_at" type="DATETIME" length="9999999" />
			<index name="pk_book_user" unique="PRIMARY_KEY" >
				<column name="user_uuid" />
			</index>
		</table>
		<table name="cart" prior="car" />
