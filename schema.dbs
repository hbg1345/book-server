<project name="book_sever" database="LogicalDesign" id="ad2d4428-610f-427f-8cdd-9c479ccfbced" >
	<schema name="Schema_" >
		<table name="Entity" />
		<table name="author" prior="Enti" >
			<column name="author_uuid" type="UUID" mandatory="y" />
			<column name="author_name" type="NVARCHAR" length="100" mandatory="y" />
