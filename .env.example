# Copy to .env (gitignored) and fill in. docker compose reads .env automatically.
# Never commit real keys — .env.example is a template and holds placeholders only.

# --- Stripe (#25) ---
# Test-mode secret key from the Stripe dashboard (Developers -> API keys). Required: the app
# has no fallback payment gateway and will not start without it.
STRIPE_SECRET_KEY=sk_test_replace_me

# Endpoint signing secret used to authenticate incoming webhooks. Locally this is the
# whsec_... value printed by:  stripe listen --forward-to localhost:8080/api/webhooks/stripe
# In a real deployment it comes from the webhook endpoint you register in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Currency charges are made in. Note zero-decimal currencies (krw, jpy) are charged in whole
# units, so switching to krw means the catalog's prices must be whole numbers too.
STRIPE_CURRENCY=usd

# --- optional overrides (defaults in docker-compose.yml are fine for local use) ---
# POSTGRES_DB=bookdb
# POSTGRES_USER=bookuser
# POSTGRES_PASSWORD=bookpass
# JWT_SECRET=
